---
import Layout from '../layouts/Layout.astro';
import ThemeToggle from '../components/ThemeToggle';
---
<Layout>
  <main class="splash">
    <h1 class="sr-only">Yagu — Sitio en construcción</h1>
    <img class="splash__logo" src="/brand/logo.svg" alt="Yagu" width="1533" height="412" />
    <img class="splash__decoration" src="/brand/logo-dashed.svg" alt="" aria-hidden="true" width="1536" height="415" />
    <ThemeToggle client:load />
  </main>
</Layout>
